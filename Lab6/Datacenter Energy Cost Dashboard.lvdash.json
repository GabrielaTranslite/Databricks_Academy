{
  "datasets": [
    {
      "name": "1093eea9",
      "displayName": "consumption_hourly",
      "config": {
        "source": "workspace.gold.consumption_hourly",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "expr": "dim_date.* EXCEPT (date)"
          }
        ],
        "joins": [
          {
            "name": "dim_datacenter",
            "source": "workspace.gold.dim_datacenter",
            "on": "source.site_id = dim_datacenter.site_id"
          },
          {
            "name": "dim_date",
            "source": "workspace.gold.dim_date",
            "cardinality": "many_to_one",
            "on": "source.date = dim_date.date",
            "rely": {
              "atMostOneMatch": false
            }
          }
        ]
      }
    }
  ],
