        "measures": [
          {
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count",
            "expr": "COUNT(*)",
            "name": "count"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "expr": "dim_date.* EXCEPT (date)"
          }
        ],
        "joins": [
          {
            "name": "dim_datacenter",
            "on": "source.site_id = dim_datacenter.site_id",
            "source": "dbr_dev.gabrielajaniszews786_gold.dim_datacenter"
          },
          {
            "name": "dim_date",
            "source": "dbr_dev.gabrielajaniszews786_gold.dim_date",
            "cardinality": "many_to_one",
            "on": "source.date = dim_date.date",
