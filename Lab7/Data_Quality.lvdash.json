{
  "datasets": [
    {
      "name": "5bf2eefe",
      "displayName": "data_quality_summary",
      "queryLines": [
        "SELECT\r\n",
        "  'prices' AS dataset,\r\n",
        "  'valid' AS status,\r\n",
        "  count(*) AS n\r\n",
        "FROM\r\n",
        "  IDENTIFIER(:catalog_name || '.' || :schema_name || '.valid_prices')\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  'prices',\r\n",
        "  'quarantine',\r\n",
        "  count(*)\r\n",
        "FROM\r\n",
        "  IDENTIFIER(:catalog_name || '.' || :schema_name || '.quarantine_prices')\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  'sensor',\r\n",
        "  'valid',\r\n",
        "  count(*)\r\n",
        "FROM\r\n",
        "  IDENTIFIER(:catalog_name || '.' || :schema_name || '.valid_sensor')\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  'sensor',\r\n",
        "  'quarantine',\r\n",
        "  count(*)\r\n",
        "FROM\r\n",
        "  IDENTIFIER(:catalog_name || '.' || :schema_name || '.quarantine_sensor')"
      ],
      "parameters": [
        {
          "displayName": "Catalog",
          "keyword": "catalog_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "Schema",
          "keyword": "schema_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "silver"
                }
              ]
            }
          }
        }
      ],
      "catalog": "workspace",
      "schema": "silver"
    },
    {
      "name": "45815fe5",
      "displayName": "passrate",
      "queryLines": [
        "SELECT dataset, round(100.0 * valid / (valid + quarantine), 2) AS pass_rate_pct\r\n",
        "FROM (\r\n",
        "  SELECT 'prices' AS dataset,\r\n",
        "    (SELECT count(*) FROM IDENTIFIER(:catalog || '.' || :schema || '.valid_prices'))      AS valid,\r\n",
        "    (SELECT count(*) FROM IDENTIFIER(:catalog || '.' || :schema || '.quarantine_prices')) AS quarantine\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'sensor',\r\n",
        "    (SELECT count(*) FROM IDENTIFIER(:catalog || '.' || :schema || '.valid_sensor')),\r\n",
        "    (SELECT count(*) FROM IDENTIFIER(:catalog || '.' || :schema || '.quarantine_sensor'))\r\n",
        ")"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "silver"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b67765f0",
      "displayName": "latest_reconciliation",
      "queryLines": [
        "WITH r AS (\r\n",
        "  SELECT * FROM IDENTIFIER(:catalog || '.' || :schema || '.reconciliation_results')\r\n",
        ")\r\n",
        "SELECT check_name, status, from_utc_timestamp(reconciliation_date, 'Europe/Warsaw') AS reconciliation_date\r\n",
        "FROM r\r\n",
        "WHERE reconciliation_date = (SELECT max(reconciliation_date) FROM r)\r\n",
        "ORDER BY check_name"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "silver"
                }
              ]
            }
          }
        }
      ]
    },
